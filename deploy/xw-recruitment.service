[Unit]
Description=XW Recruitment Spring Boot API
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/xw/backend
EnvironmentFile=/etc/xw-recruitment.env
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /opt/xw/backend/target/recruitment-api-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
