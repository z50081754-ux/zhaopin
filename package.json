{
  "name": "tx-talent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test src/composables/*.test.ts",
    "dev:admin": "npm --prefix admin run dev",
    "build": "vue-tsc -b && vite build",
    "build:admin": "npm --prefix admin run build",
    "build:all": "npm run build && npm run build:admin",
    "deploy:web": "bash scripts/deploy-web.sh",
    "deploy:all": "bash scripts/deploy-all.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "vue-tsc": "^3.1.4"
  }
}
